{
  "name": "@local/dsh-stock-ticker",
  "version": "1.8.8",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness (DSH) plugin: a configurable A-share / Hong Kong / US quote strip under the composer, with watchlist groups, search, price alerts, holdings with a cost line, mini K-line, intraday (1/3/5 days), minute/daily/weekly/monthly charts, five-level order book and a stock_quote agent tool. 股票行情、自选股、盯盘、K线、预警插件。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:offline": "node scripts/verify.mjs --offline",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "lint": "oxlint .",
    "check": "node --check index.js && node --check client.js && node --check lib/routes.js && node --check lib/providers/index.js",
    "pack:check": "node scripts/pack-check.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "homepage": "https://github.com/mimidor/dsh-stock-dock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimidor/dsh-stock-dock.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "stock",
    "stock-quotes",
    "ticker",
    "watchlist",
    "alerts",
    "portfolio",
    "kline",
    "candlestick",
    "a-share",
    "hk-stocks",
    "us-stocks",
    "market-data",
    "agent-tool"
  ],
  "license": "MIT",
  "devDependencies": {
    "oxlint": "^1.93.0"
  }
}

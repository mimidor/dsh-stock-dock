{
  "name": "@local/dsh-stock-ticker",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness (DSH) plugin: a configurable A-share / Hong Kong / US quote strip under the composer, with mini K-line, intraday, daily/weekly/monthly charts and five-level order book. 股票行情、自选股、盯盘、K线插件。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:offline": "node scripts/verify.mjs --offline",
    "check": "node --check index.js && node --check client.js"
  },
  "homepage": "https://github.com/mimidor/dsh-stock-dock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimidor/dsh-stock-dock.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "stock",
    "stock-quotes",
    "ticker",
    "watchlist",
    "kline",
    "candlestick",
    "a-share",
    "hk-stocks",
    "us-stocks",
    "market-data"
  ],
  "license": "MIT"
}
